# PostgreSQL connection used only by server code.
DATABASE_URL=postgresql://user:password@localhost:5432/econnvrae

# Enable only when the database server requires TLS.
# When true, provide the trusted CA certificate with \n between lines.
DATABASE_SSL=false
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# HMAC pepper for IP and identifier fingerprints in rate limits/audit logs.
# Required in production. Use at least 32 cryptographically random characters.
AUTH_HASH_PEPPER=

# Enable only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false

# Initial accounts used only by `npm run db:seed`.
# Use unique passwords of at least 12 characters and remove them after seeding.
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin1
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_USERNAME=operador1
SEED_OPERATOR_PASSWORD=
SEED_DRIVER_USERNAME=conductor1
SEED_DRIVER_PASSWORD=

# Server-only DNI provider token.
RENIEC_API_TOKEN=

# Development-only deterministic names. Never enable in a demonstration with real data.
ALLOW_DNI_MOCK_FALLBACK=false

# Optional trusted cross-origin web client. Example: https://app.tudominio.com
ALLOWED_ORIGIN=
